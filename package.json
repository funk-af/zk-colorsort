    "circomlib": "^2.0.5",
    "lute-connect": "^1.7.0",
    "pinia": "^2.1.0",
    "snarkjs-algorand": "^0.13.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",

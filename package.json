{
  "name": "zk-colorsort",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:contracts": "pnpm run test:contracts:unit && pnpm run test:contracts:e2e",
    "test:contracts:unit": "vitest run --config vitest.config.contracts.ts contracts/tests/PuzzleScores.algo.unit.test.ts",
    "test:contracts:e2e": "vitest run --config vitest.config.contracts.ts contracts/tests/PuzzleScores.algo.e2e.spec.ts",
    "compile:contracts": "algokit compile ts contracts --out-dir artifacts",
    "generate:client": "algokit generate client contracts/artifacts/PuzzleScores.arc56.json --language typescript --output src/algorand/PuzzleScoresClient.ts && node -e \"const f='src/algorand/PuzzleScoresClient.ts';const fs=require('fs');const s=fs.readFileSync(f,'utf8');if(!s.startsWith('// @ts-nocheck'))fs.writeFileSync(f,'// @ts-nocheck\\n'+s)\" && node scripts/fix-client-imports.mjs src/algorand/PuzzleScoresClient.ts",
    "build:contracts": "pnpm run compile:contracts && pnpm run generate:client",
    "test:functions:e2e": "vitest run --config vitest.config.contracts.ts netlify/functions/tests/sponsored-functions.e2e.spec.ts",
    "typecheck:functions": "tsc -p tsconfig.netlify.json --noEmit",
    "export:vk": "node scripts/export-vk.ts",
    "deploy:contract": "tsx contracts/deploy.ts",
    "discord:register-commands": "tsx scripts/register-discord-commands.ts"
  },
  "dependencies": {
    "@algorandfoundation/algokit-utils": "^9.2.2",
    "@discord/embedded-app-sdk": "^2.5.0",
    "@galaxypay/use-wallet-lute": "^1.0.0",
    "@txnlab/use-wallet-pera": "^5.0.1",
    "@txnlab/use-wallet-ui-vue": "^1.0.0",
    "@txnlab/use-wallet-vue": "^5.0.1",
    "algosdk": "^3.8.0",
    "pinia": "^2.3.1",
    "snarkjs-algorand": "^0.14.0",
    "vue": "^3.5.43",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@algorandfoundation/algokit-utils-debug": "^1.0.4",
    "@algorandfoundation/algorand-typescript": "^1.3.1",
    "@algorandfoundation/algorand-typescript-testing": "^1.2.0",
    "@algorandfoundation/puya-ts": "^1.3.1",
    "@netlify/functions": "^6.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.9.8",
    "@types/snarkjs": "^0.7.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.5.1",
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}

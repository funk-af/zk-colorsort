# --- Frontend (Vite, build time) ---
# Discord application id; the app only enters Activity mode inside Discord.
VITE_DISCORD_CLIENT_ID=
# Public website origin the Activity opens for the permanent (wallet) option.
VITE_SITE_URL=https://example.netlify.app

# --- Netlify functions (runtime) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# "Public Key" from the app's General Information page; verifies slash
# command and button interactions sent to /api/discord-interactions.
DISCORD_PUBLIC_KEY=
# Bot token, only needed locally by `pnpm run discord:register-commands`.
# DISCORD_BOT_TOKEN=
# Dedicated sponsor account holding only a small fee float.
SPONSOR_MNEMONIC=
# Pause sponsored submissions when the sponsor's spendable balance (microAlgos)
# drops below this.
SPONSOR_MIN_BALANCE=500000
# Discord accounts younger than this are refused sponsored submissions.
MIN_DISCORD_ACCOUNT_AGE_DAYS=14
# mainnet | testnet | localnet (selects indexer + default app id)
ALGORAND_NETWORK=mainnet
# Optional overrides
# PUZZLE_SCORES_APP_ID=3603459425
# ALGOD_URL=https://mainnet-api.algonode.cloud
# ALGOD_PORT=
# ALGOD_TOKEN=
